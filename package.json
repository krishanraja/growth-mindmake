{
  "name": "growth-mindmake",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led, draft-only growth orchestration for Mindmake",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/regression/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node src/cli.mjs plan --snapshot fixtures/snapshot.json --at 2026-10-16T18:00:00Z",
    "daily": "node src/cli.mjs daily",
    "engine": "node src/cli.mjs engine",
    "doctor": "node src/cli.mjs doctor",
    "scorecard": "node src/cli.mjs scorecard",
    "conveyor": "node scripts/check-stage-conveyor.mjs --root . --manifest pipeline/stage-conveyor.json",
    "readiness": "node src/cli.mjs readiness",
    "weekly-review": "node src/cli.mjs weekly-review",
    "contracts": "node scripts/check-contracts.mjs",
    "demo:review": "node src/cli.mjs weekly-review --context fixtures/review-context.json --at 2026-10-16T13:00:00Z --summary",
    "demo:engine": "node src/cli.mjs engine --context fixtures/engine-context.json --at 2026-10-16T18:00:00Z --summary",
    "check:crew": "node scripts/check-crew.mjs",
    "check:bespoke": "node scripts/check-bespoke.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:library": "node scripts/check-library.mjs --listing tests/fixtures/library/listing.synthetic.json --fixture",
    "mutate": "node scripts/mutate.mjs",
    "pack": "node scripts/pack.mjs",
    "dispatch-card": "node scripts/dispatch-card.mjs",
    "verify-card": "node scripts/verify-card.mjs",
    "check:switch": "node scripts/check-switch.mjs",
    "measure-20x": "node scripts/measure-20x.mjs"
  }
}
