{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krishanraja/ai-harness/skills/krish-build/references/stage-conveyor-manifest.schema.json",
  "title": "Repository stage conveyor manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "inventory", "external_inputs", "terminal_outputs", "stages", "edges", "guards", "entrypoints", "learnings"],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline_id": {"type": "string", "minLength": 1},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "extensions", "exclude"],
      "properties": {
        "roots": {"$ref": "#/$defs/nonEmptyStrings"},
        "extensions": {"$ref": "#/$defs/nonEmptyStrings"},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "external_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "terminal_outputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "owned_paths", "inputs", "outputs", "consumed_guards", "side_effects", "retry", "completion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "owned_paths": {"$ref": "#/$defs/nonEmptyStrings"},
          "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
          "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
          "consumed_guards": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "side_effects": {"$ref": "#/$defs/nonEmptyStrings"},
          "retry": {"$ref": "#/$defs/retry"},
          "completion": {"$ref": "#/$defs/completion"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "artifact"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1}
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "owned_paths", "required_for", "enforced_by"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "owned_paths": {"$ref": "#/$defs/nonEmptyStrings"},
          "required_for": {"$ref": "#/$defs/nonEmptyStrings"},
          "enforced_by": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "path", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["primary", "recovery"]}
        }
      }
    },
    "learnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner_stage", "enforced_by"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner_stage": {"type": "string", "minLength": 1},
          "enforced_by": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "total_attempt_cap", "checkpoint", "recovery_entrypoint"],
      "properties": {
        "mode": {"enum": ["idempotent", "at_most_once", "manual"]},
        "total_attempt_cap": {"type": "integer", "minimum": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "recovery_entrypoint": {"type": "string", "minLength": 1}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence"],
      "properties": {
        "source": {"enum": ["authoritative_output", "destination_readback", "rendered_artifact", "independent_rederivation"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
