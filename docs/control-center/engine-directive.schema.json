{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcenter.krishraja.com/schemas/engine-directive-1.0.0.json",
  "title": "Growth engine directive, protocol 1.0.0 to 1.8.0 (ADR-038)",
  "type": "object",
  "required": [
    "schema_version",
    "directive_id",
    "engine_id",
    "for_date",
    "aim",
    "objectives",
    "next_action",
    "decisions_since",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "The newest 1.x Control Center speaks. Accept any 1.x and ignore fields you do not know: within 1.x Control Center only adds."
    },
    "directive_id": {
      "type": "string"
    },
    "engine_id": {
      "type": "string"
    },
    "for_date": {
      "type": "string",
      "format": "date"
    },
    "aim": {
      "type": [
        "string",
        "null"
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "target",
          "unit",
          "window",
          "timezone",
          "latest",
          "availability"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string"
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "latest": {
            "type": [
              "number",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "measured",
              "missing",
              "stale",
              "unreported"
            ]
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": [
        "proposal_id",
        "instruction",
        "why",
        "close_condition"
      ],
      "properties": {
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruction": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "close_condition": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "event": {
              "type": "string"
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "decisions_since": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposal_id",
          "decision",
          "decided_at",
          "payload_sha256",
          "stage",
          "amended"
        ],
        "properties": {
          "proposal_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "approved",
              "declined",
              "done"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "payload_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "enum": [
              "plan",
              "go_live",
              "check_in",
              null
            ]
          },
          "amended": {
            "type": "boolean",
            "description": "He changed it before approving. Act on his version (exact_payload, amount_usd), never your own."
          },
          "exact_payload": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present when amended: his words."
          },
          "amount_usd": {
            "type": [
              "number",
              "null"
            ],
            "description": "Present when amended: his amount."
          },
          "amended_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Present when amended: SHA-256 of the canonical JSON of {amount_usd, exact_payload}."
          },
          "carried_out": {
            "enum": [
              "draft",
              "message",
              "submit"
            ],
            "description": "1.6.0, present when set: Krish carried it out himself from his home screen (a Gmail draft he sends, a message app opened with the words typed, a form submitted on his tap). Never send or submit it yourself."
          },
          "reason_code": {
            "enum": [
              "wrong_person",
              "not_now",
              "already_in_touch",
              "too_small",
              "wrong_audience",
              "not_my_topic",
              "pitch_off",
              "other"
            ],
            "description": "1.6.0, present on a No he gave a reason for. Offer better, and do not offer that person, or anything like it on that reason, again."
          },
          "reason_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "description": "1.6.0, with reason_code: his own words, when he gave any."
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "walls",
        "autonomy",
        "autonomy_rule",
        "spend_cap_usd",
        "max_actions"
      ],
      "properties": {
        "walls": {
          "type": "string"
        },
        "spend_cap_usd": {
          "type": "number"
        },
        "max_actions": {
          "type": "integer"
        },
        "autonomy": {
          "enum": [
            "handcrafted",
            "autonomous"
          ]
        },
        "autonomy_rule": {
          "type": "string",
          "description": "Who carries out an approved send, post or spend, word for word."
        }
      }
    },
    "in_house": {
      "type": "object",
      "description": "Mindmake only: what Advisory, Network and Visibility did this week inside Control Center. A part that could not be read is null.",
      "required": [
        "rule",
        "counts"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "required": [
            "week_start",
            "advisory",
            "network",
            "visibility"
          ],
          "properties": {
            "week_start": {
              "type": "string",
              "format": "date"
            },
            "advisory": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "drafted_waiting": {
                  "type": "integer"
                },
                "sent_this_week": {
                  "type": "integer"
                },
                "replied_waiting": {
                  "type": "integer"
                },
                "calls_booked_this_week": {
                  "type": "integer"
                },
                "paid": {
                  "type": "integer"
                }
              }
            },
            "network": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "warm_people": {
                  "type": "integer"
                }
              }
            },
            "visibility": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "stages_open": {
                  "type": "integer"
                },
                "applied_this_week": {
                  "type": "integer"
                },
                "rooms_going": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "aim_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "1.4.0: the parent product's North Star deadline."
    },
    "week_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "1.4.0: this week's rung of the parent product's weekly ladder."
    },
    "week_target": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "1.4.0: the parent product's target for this week."
    },
    "current": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "1.4.0: the parent product's latest reading."
    },
    "urgency": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5,
      "description": "1.4.0: U1 to U5 by ai-harness contract/north-star-metric.md; null when paused."
    },
    "urgency_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "1.4.0: why that urgency."
    },
    "north_star": {
      "type": "object",
      "description": "1.4.0: the parent product's number, the engine's own, and what urgency asks of it. The walls and caps never move with it.",
      "properties": {
        "parent": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "metric": {
              "type": [
                "string",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "aim_by": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "week_of": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "week_target": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "A figure, or \"private\" for a repository whose figures are private."
            },
            "current": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "A figure, or \"private\" for a repository whose figures are private."
            },
            "urgency": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "urgency_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "read_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "own": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "metric": {
              "type": [
                "string",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "aim_by": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "week_of": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "week_target": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "A figure, or \"private\" for a repository whose figures are private."
            },
            "current": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "A figure, or \"private\" for a repository whose figures are private."
            },
            "urgency": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "urgency_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "read_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "intensity": {
          "type": "object",
          "properties": {
            "urgency": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "drafts_multiplier": {
              "type": "number"
            },
            "rule": {
              "type": "string"
            }
          }
        }
      }
    },
    "taste": {
      "type": "object",
      "description": "1.5.0, optional. Krish's approved voice rules for what the engine drafts: follow them for how it is written, never to choose what it is about, never to judge. An empty list means none approved yet; absent means they could not be read.",
      "required": [
        "rule",
        "approved_voice_rules"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "approved_voice_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "layer",
              "rule",
              "his_words",
              "what_it_means"
            ],
            "properties": {
              "layer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rule": {
                "type": "string"
              },
              "his_words": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "what_it_means": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "week_goals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      },
      "description": "1.6.0, optional: his goals for this week in his own words, newest week. A row proposal's serves quotes one exactly. Empty when none set; absent when they could not be read."
    },
    "rows_rule": {
      "type": "string",
      "description": "1.6.0, Mindmake only, with week_goals: how to put people in front of him (ENGINE-PROTOCOL.md, The five rows), word for word."
    }
  }
}
