{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcenter.krishraja.com/schemas/engine-report-1.0.0.json",
  "title": "Growth engine report, protocol 1.10.0 (ADR-038)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_id",
    "product_slug",
    "run_id",
    "mode",
    "observed_at",
    "source",
    "status",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0",
        "1.6.0",
        "1.7.0",
        "1.8.0",
        "1.9.0",
        "1.10.0"
      ],
      "description": "1.1.0 adds a proposal's stage and parent_proposal_id, 1.2.0 its subject_ref; an older report carrying a newer field is refused. 1.3.0 adds scoped context/outcome reads and exact action execution without changing report fields. 1.4.0 and 1.5.0 change only the directive. 1.6.0 adds a proposal's row, rank, reach, amplifier_kind, features, serves and source_revision, and allows 40 proposals (ENGINE-PROTOCOL.md, The five rows). 1.7.0 adds a row proposal's because and brief, which a row then needs. 1.8.0 adds a row proposal's card, the full card a tap opens, which a row then needs. 1.9.0 lets a visibility or events row's email action (exact_payload) name Jonny's box (mailbox), and changes no report field. 1.10.0 adds web_analytics to the directive of an engine whose product has a Google Analytics site with the per-post breakdown, origin_candidates to the report of the engine whose meetings Control Center reads (Mindmake, features.meetings), and a row action's kind show_notes_ask (exact_payload), Jonny's show-notes note after a booking."
    },
    "engine_id": {
      "type": "string",
      "maxLength": 64
    },
    "product_slug": {
      "type": "string",
      "maxLength": 64
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
    },
    "mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "captured_at"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "maxLength": 128
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "held",
        "degraded"
      ]
    },
    "objectives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "unit",
          "availability"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "window_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "window_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "measured",
              "missing",
              "stale"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "title",
          "why",
          "kind",
          "wall",
          "payload_sha256",
          "close_condition"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "why": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "enum": [
              "advice",
              "prepared",
              "autonomous"
            ]
          },
          "wall": {
            "enum": [
              "none",
              "spend",
              "send",
              "post",
              "strategy"
            ]
          },
          "amount_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "objective_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "exact_payload": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000,
            "description": "The exact words to approve. On a row proposal (1.6.0), a version 2 action as JSON text: { version: 2, channel, recipient_contact_id, subject, body, form, mailbox, kind }, never an address. mailbox (1.9.0): krish, jonny or null; jonny on the visibility and events rows only. kind (1.10.0, optional): show_notes_ask or null, only on an email with mailbox jonny about a stage (subject_ref target:<id>): Jonny's one note to a host after his pitch was booked, asking for the brief link in the show notes, drafted once a stage only after booked_at is recorded (ENGINE-PROTOCOL.md, The show-notes note). An older report naming a kind is refused."
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 500
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^https://\\S+$"
                }
              }
            }
          },
          "close_condition": {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stage": {
            "enum": [
              "plan",
              "go_live",
              "check_in",
              null
            ],
            "description": "1.1.0. An autonomous engine's plan (behind a wall, waiting on his yes), its go-live (send, post or spend) for his review, or a check-in (a strategy call naming its plan, with its progress in exact_payload)."
          },
          "parent_proposal_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "1.1.0. The plan a go-live carries out. Required on a go-live."
          },
          "subject_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(contact|target|event):[A-Za-z0-9_-]{1,64}$",
            "description": "1.2.0. The person, stage or room the proposal is about, by the id Control Center gave the engine. His list keeps Control Center's own copy of the same subject instead."
          },
          "row": {
            "enum": [
              "reach_out",
              "network",
              "visibility",
              "events",
              "partners",
              null
            ],
            "description": "1.6.0: the row on Krish's home screen. A row proposal is a prepared send with stage null, a subject_ref, a rank, a source_revision and a version 2 action in exact_payload. Its title is the line on his phone, shown whole: at most 72 characters."
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000,
            "description": "1.6.0: the engine's order within the row, 1 first."
          },
          "reach": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "value",
              "band",
              "basis",
              "source_url",
              "as_of"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "A sourced number, or null. A number needs source_url and as_of, and its band must match it."
              },
              "band": {
                "enum": [
                  "under_1k",
                  "1k_10k",
                  "10k_100k",
                  "100k_1m",
                  "over_1m",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "What is counted: portfolio companies, members, learners a year, subscribers."
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://\\S+$",
                "maxLength": 2000
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "amplifier_kind": {
            "enum": [
              "investor",
              "connector",
              "ai_capital",
              "ai_trainer",
              "student_educator",
              "ceo_educator",
              "broadcaster",
              null
            ]
          },
          "features": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "sector": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_ -]{0,59}$"
              },
              "topic": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_ -]{0,59}$"
              },
              "seniority": {
                "enum": [
                  "c_suite",
                  "senior",
                  "other",
                  null
                ]
              }
            },
            "description": "1.6.0: what his reasons for a No filter on."
          },
          "serves": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300,
            "description": "1.6.0: one of the directive's week_goals, word for word."
          },
          "source_revision": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "path",
                "sha"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "The file's git blob SHA on the default branch when the words were written."
                }
              }
            },
            "description": "1.6.0: every file the words were written from. Control Center refuses the action once one has moved."
          },
          "because": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80,
            "description": "1.7.0: the line under the title on his card, two lines of it: who they are and why them, in plain words. Required with row at 1.7.0, when the row's title is at most 56 characters."
          },
          "brief": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "1.7.0: the case he reads when he taps the card: who they are, how he knows them, why them, what a yes gets him, the reach and its basis. Required with row at 1.7.0."
          },
          "card": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "who",
              "known",
              "why",
              "gain",
              "angles",
              "sources"
            ],
            "properties": {
              "who": {
                "type": "string",
                "minLength": 1,
                "maxLength": 320,
                "description": "Who they are and what their organisation does."
              },
              "known": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "How he knows them: since when, through what, the emails each way and the last one. Never a claim the counts contradict."
              },
              "why": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "description": "Why them, and why now: whole sentences."
              },
              "gain": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "description": "What he gets if they say yes, tied to the week goal it serves: whole sentences, numbers only with their source."
              },
              "angles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "line"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "line": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  }
                },
                "description": "The angles to take, each a short name from the venture's own canon and a line tying it to this person."
              },
              "sources": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "url"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://\\S+$",
                      "maxLength": 2000
                    }
                  }
                },
                "description": "The public pages the facts came from. Never a profile or an address: a LinkedIn profile, mailto:, wa.me or tel: link is refused."
              }
            },
            "description": "1.8.0: the full card a tap opens: who they are, how he knows them, why them now, what he gets and the angles to take, with the pages the facts came from (Krish, 2026-10-27). Required with row at 1.8.0."
          }
        }
      },
      "description": "At most 10 before 1.6.0; 1.6.0 allows 40, a ranked queue for each of the five rows."
    },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "event",
          "at"
        ],
        "properties": {
          "event": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "proposal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "origin_candidates": {
      "type": "array",
      "maxItems": 40,
      "description": "1.10.0, Mindmake only (features.meetings), optional: where the engine reads each of his recent meetings came from. The first candidate naming a path for the person he met is recorded at his good tap, once; any other path for them is kept as an assist (ENGINE-PROTOCOL.md, Held meetings and the good tap).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contact_id",
          "path"
        ],
        "properties": {
          "contact_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "path": {
            "enum": [
              "existing-relationship",
              "multiplier-intro",
              "partner",
              "guest-seat",
              "podcast",
              "own-show-guest",
              "public-signal",
              "inbound",
              "referral",
              "unknown"
            ]
          },
          "origin_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "A stable id (contact:<id>, a proposal id) or a public https page, never an address."
          }
        }
      }
    },
    "withdrawn": {
      "type": "array",
      "maxItems": 40,
      "description": "1.10.0, optional: your own pending proposals you take back, each with why. Each one Krish has not decided becomes expired and leaves his list; a decided one is left as it is. Never both proposed and withdrawn in one report.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "reason"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "suppression": {
      "type": "object",
      "description": "Optional, sent only when Control Center's capabilities say features.suppression (plan section 12, M10): the engine's suppression of what Krish said No to, as references only. It replaces every earlier list. Control Center applies it with schema checks only.",
      "additionalProperties": false,
      "required": [
        "version",
        "as_of",
        "never",
        "not_on_row",
        "paused",
        "reach_floor",
        "audiences",
        "topics"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "as_of": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "format": "date-time"
        },
        "never": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{2,20}:[A-Za-z0-9._:-]{1,120}$"
          }
        },
        "not_on_row": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row",
              "subject_ref"
            ],
            "properties": {
              "row": {
                "type": "string",
                "pattern": "^[a-z_]{2,20}$"
              },
              "subject_ref": {
                "type": "string",
                "pattern": "^[a-z_]{2,20}:[A-Za-z0-9._:-]{1,120}$"
              }
            }
          }
        },
        "paused": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject_ref",
              "until"
            ],
            "properties": {
              "subject_ref": {
                "type": "string",
                "pattern": "^[a-z_]{2,20}:[A-Za-z0-9._:-]{1,120}$"
              },
              "until": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40,
                "format": "date-time"
              }
            }
          }
        },
        "reach_floor": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "at_or_below"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z_]{2,30}$"
              },
              "at_or_below": {
                "type": "string",
                "pattern": "^[a-z0-9_]{2,20}$"
              }
            }
          }
        },
        "audiences": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "sector"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z_]{2,30}$"
              },
              "sector": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 59
              }
            }
          }
        },
        "topics": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 59
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "description": "Optional, sent beside suppression only when features.suppression is served (plan section 12, M10): the engine's row taxonomy and card doctrine, identifiers and integers only, at most 2 KB. Control Center checks against it in place of its own lists.",
      "additionalProperties": false,
      "required": [
        "version",
        "rows",
        "kinds",
        "bands",
        "reasons",
        "carried_out",
        "ask_for",
        "row_for",
        "doctrine"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "rows": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          }
        },
        "kinds": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          }
        },
        "bands": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "string",
