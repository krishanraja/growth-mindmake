{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcenter.krishraja.com/schemas/engine-report-1.0.0.json",
  "title": "Growth engine report, protocol 1.7.0 (ADR-038)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_id",
    "product_slug",
    "run_id",
    "mode",
    "observed_at",
    "source",
    "status",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0",
        "1.6.0",
        "1.7.0"
      ],
      "description": "1.1.0 adds a proposal's stage and parent_proposal_id, 1.2.0 its subject_ref; an older report carrying a newer field is refused. 1.3.0 adds scoped context/outcome reads and exact action execution without changing report fields. 1.4.0 and 1.5.0 change only the directive. 1.6.0 adds a proposal's row, rank, reach, amplifier_kind, features, serves and source_revision, and allows 40 proposals (ENGINE-PROTOCOL.md, The five rows). 1.7.0 adds a row proposal's because and brief, which a row proposal then carries (ENGINE-PROTOCOL.md, The five rows)."
    },
    "engine_id": {
      "type": "string",
      "maxLength": 64
    },
    "product_slug": {
      "type": "string",
      "maxLength": 64
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
    },
    "mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "captured_at"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "maxLength": 128
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "held",
        "degraded"
      ]
    },
    "objectives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "unit",
          "availability"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "window_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "window_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "measured",
              "missing",
              "stale"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "title",
          "why",
          "kind",
          "wall",
          "payload_sha256",
          "close_condition"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "description": "On a row proposal: at most 72 characters at 1.6.0 and at most 56 at 1.7.0, where it sits beside the presses on two lines and the line under it says who they are."
          },
          "why": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "enum": [
              "advice",
              "prepared",
              "autonomous"
            ]
          },
          "wall": {
            "enum": [
              "none",
              "spend",
              "send",
              "post",
              "strategy"
            ]
          },
          "amount_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "objective_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "exact_payload": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 500
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^https://\\S+$"
                }
              }
            }
          },
          "close_condition": {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stage": {
            "enum": [
              "plan",
              "go_live",
              "check_in",
              null
            ],
            "description": "1.1.0. An autonomous engine's plan (behind a wall, waiting on his yes), its go-live (send, post or spend) for his review, or a check-in (a strategy call naming its plan, with its progress in exact_payload)."
          },
          "parent_proposal_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "1.1.0. The plan a go-live carries out. Required on a go-live."
          },
          "subject_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(contact|target|event):[A-Za-z0-9_-]{1,64}$",
            "description": "1.2.0. The person, stage or room the proposal is about, by the id Control Center gave the engine. His list keeps Control Center's own copy of the same subject instead."
          },
          "row": {
            "enum": [
              "reach_out",
              "network",
              "visibility",
              "events",
              "partners",
              null
            ],
            "description": "1.6.0: the row on Krish's home screen. A row proposal is a prepared send with stage null, a subject_ref, a rank, a source_revision and a version 2 action in exact_payload. Its title is the line on his phone, shown whole: at most 72 characters."
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000,
            "description": "1.6.0: the engine's order within the row, 1 first."
          },
          "reach": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "value",
              "band",
              "basis",
              "source_url",
              "as_of"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "A sourced number, or null. A number needs source_url and as_of, and its band must match it."
              },
              "band": {
                "enum": [
                  "under_1k",
                  "1k_10k",
                  "10k_100k",
                  "100k_1m",
                  "over_1m",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "What is counted: portfolio companies, members, learners a year, subscribers."
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://\\S+$",
                "maxLength": 2000
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "amplifier_kind": {
            "enum": [
              "investor",
              "connector",
              "ai_capital",
              "ai_trainer",
              "student_educator",
              "ceo_educator",
              "broadcaster",
              null
            ]
          },
          "features": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "sector": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_ -]{0,59}$"
              },
              "topic": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_ -]{0,59}$"
              },
              "seniority": {
                "enum": [
                  "c_suite",
                  "senior",
                  "other",
                  null
                ]
              }
            },
            "description": "1.6.0: what his reasons for a No filter on."
          },
          "serves": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300,
            "description": "1.6.0: one of the directive's week_goals, word for word."
          },
          "source_revision": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "path",
                "sha"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "The file's git blob SHA on the default branch when the words were written."
                }
              }
            },
            "description": "1.6.0: every file the words were written from. Control Center refuses the action once one has moved."
          },
          "because": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80,
            "description": "1.7.0: the line under the title on Krish's card, two lines of about 40 characters, shown whole: who they are and why them in one clause, then how he knows them. Never a cut word or an ellipsis. Required on a row proposal at 1.7.0."
          },
          "brief": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "1.7.0: the case a tap on the card opens: who they are, how he knows them, why them, what a yes gets him, reach with its basis and the Mindmake fit. Required on a row proposal at 1.7.0."
          }
        }
      },
      "description": "At most 10 before 1.6.0; 1.6.0 allows 40, a ranked queue for each of the five rows."
    },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "event",
          "at"
        ],
        "properties": {
          "event": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "proposal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
