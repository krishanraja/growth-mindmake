      "retry": {
        "mode": "idempotent",
        "total_attempt_cap": 1,
        "checkpoint": "Semantic source revision in the durable batch journal",
        "recovery_entrypoint": "analyse-recovery"
      },
      "completion": {
        "source": "independent_rederivation",
        "evidence": "tests/planning.test.mjs verifies current sources, holds, caps and route"
